# Reference only — this file isn't read by anything. Copy what you need
# into the real files:
#   Next app   -> .env.local (repo root)
#   Convex app -> convex/.env.convex.<name>, pushed with
#                 `npm run env:push -- convex/.env.convex.<name>`
# Full walkthrough: docs/local-testing.md

# ============================== Next app ================================
# Read by `next dev` / the deployed Next app. Goes in .env.local.

# Which Convex deployment the CLI targets and the app talks to.
# Populated automatically by `npx convex dev` on first run — let it write
# these three, don't hand-edit unless you're switching deployments.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# The app's own address, and the domain shop sites live on in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=footfall.zone

# Serves the fake Google Business Profile at /api/mock/google, so the
# product can be exercised without a real listing.
GOOGLE_MOCK_ENABLED=1

# Only for the real Google consent screen. Unused while the mock above
# is on.
# GOOGLE_CLIENT_ID=

# ============================= Convex app ================================
# Read by Convex functions, not by Next. Goes in
# convex/.env.convex.<name>, one file per deployment.

# Where the OAuth callback sends the browser back.
SITE_URL=http://localhost:3000
# Dev only: prints sign-in codes to the backend log instead of sending them.
OTP_DEV_ECHO=1

# Drafts posts and review replies.
OPENAI_API_KEY=
# Crawls a shop's existing site during onboarding.
FIRECRAWL_API_KEY=
# Optional, paid per search: rank checks and keyword research.
SERPAPI_KEY=
# Optional: keyword search volumes.
DATAFORSEO_AUTH=

# Billing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dev only: verify the payment but leave the plan grant to the webhook.
# RAZORPAY_WEBHOOK_ONLY=1

# The fake Google Business Profile. A cloud deployment needs a tunnel URL
# here instead of localhost.
GOOGLE_API_MOCK_URL=http://127.0.0.1:3000/api/mock/google

# Only for the real Google consent screen, to connect a Google Business
# Profile. Unneeded while the mock above is on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Only for "sign in with Google" (identity only — separate from the GBP
# connection above).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Only for real SMS and email codes. Unneeded with OTP_DEV_ECHO above.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=
